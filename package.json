{
    "name": "cyclesense-app",
    "private": true,
    "version": "0.0.1",
    "type": "module",
    "scripts": {
        "dev": "vite dev",
        "build": "vite build",
        "preview": "vite preview",
        "prepare": "svelte-kit sync || echo ''",
        "check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
        "mobile:assets": "npx capacitor-assets generate --ios --android",
        "mobile:build": "IS_CAPACITOR=true npm run build && npm run mobile:assets && npx cap sync",
        "mobile:ios": "npx cap open ios",
        "mobile:android": "npx cap open android"
    },
    "devDependencies": {
        "@capacitor/assets": "^3.0.5",
        "@sveltejs/adapter-auto": "^7.0.1",
        "@sveltejs/adapter-static": "^3.0.10",
        "@sveltejs/kit": "^2.57.0",
        "@sveltejs/vite-plugin-svelte": "^7.0.0",
        "@tailwindcss/typography": "^0.5.19",
        "@tailwindcss/vite": "^4.2.2",
        "svelte": "^5.55.2",
        "svelte-check": "^4.4.6",
        "tailwindcss": "^4.2.2",
        "typescript": "^6.0.2",
        "vite": "^8.0.7"
    },
    "dependencies": {
        "@capacitor/android": "^8.4.0",
        "@capacitor/app": "^8.1.0",
        "@capacitor/cli": "^8.4.0",
        "@capacitor/core": "^8.4.1",
        "@capacitor/ios": "^8.4.0",
        "@libsql/client": "^0.14.0",
        "@lucide/svelte": "^1.17.0",
        "@revenuecat/purchases-js": "^1.41.2",
        "@revenuecat/purchases-ui-js": "^4.7.2",
        "dotenv": "^17.4.2",
        "stripe": "^22.2.0",
        "vercel": "^54.9.0"
    }
}
